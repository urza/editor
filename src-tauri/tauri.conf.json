{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vrtti",
  "version": "0.1.0",
  "identifier": "io.github.urza.vrtti",
  "build": {
    "frontendDist": "https://urza.github.io/editor/",
    "devUrl": "https://urza.github.io/editor/"
